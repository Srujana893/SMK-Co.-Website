# Copy to .env for local dev. Do NOT commit .env.
# In Railway, set these as service variables.

# Railway Postgres auto-provides DATABASE_URL when the DB is attached.
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Routing recipients (single source of truth for who receives what)
TECH_EMAIL=personA@example.com
FINANCE_EMAIL=personB@example.com

# SMTP transport (e.g. Gmail app password, SES, Postmark, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifier@example.com
SMTP_PASS=your-app-password
SMTP_FROM="SMK & Co Enquiries <notifier@example.com>"

# Optional
PORT=3000
